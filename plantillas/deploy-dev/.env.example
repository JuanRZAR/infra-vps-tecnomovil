# Copia a deploy/deploy-dev/.env (no lo subas al repositorio). Valores solo para tu equipo.
# Dentro de Docker la base se llama "db"; desde tu equipo es 127.0.0.1:5433.
DATABASE_URL=postgresql://app:app@db:5432/app
SECRET_KEY=solo-para-desarrollo
# Con servicios internos (guia 2.0): la URL con la que app llama a cada uno; es la misma que en producción
# API_URL=http://api:8000
# <OTRAS_VARIABLES>
